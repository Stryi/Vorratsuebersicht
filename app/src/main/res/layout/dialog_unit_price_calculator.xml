<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Preis -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/UnitPriceCalculator_Price"
        android:textSize="14sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/UnitPriceCalc_Price"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="numberDecimal"
        android:textSize="16sp"
        android:layout_marginBottom="12dp" />

    <!-- Menge -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/UnitPriceCalculator_Quantity"
        android:textSize="14sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/UnitPriceCalc_Quantity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="numberDecimal"
        android:textSize="16sp"
        android:layout_marginBottom="12dp" />

    <!-- Auswahl Einheit -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/UnitPriceCalculator_Unit"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <RadioGroup
        android:id="@+id/UnitPriceCalc_UnitGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <RadioButton
            android:id="@+id/UnitPriceCalc_RadioKg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Kg"
            android:checked="true" />

        <RadioButton
            android:id="@+id/UnitPriceCalc_RadioG"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="g" />

        <RadioButton
            android:id="@+id/UnitPriceCalc_RadioL"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="L" />

        <RadioButton
            android:id="@+id/UnitPriceCalc_RadioMl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ml" />
    </RadioGroup>

    <!-- Trennlinie -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?android:attr/listDivider"
        android:layout_marginBottom="12dp" />

    <!-- Ergebnisse -->
    <TextView
        android:id="@+id/UnitPriceCalc_Result1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        android:text="@string/UnitPriceCalculator_PricePerKg"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/UnitPriceCalc_Result2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        android:text="@string/UnitPriceCalculator_PricePer100G" />

</LinearLayout>
