<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="horizontal"
    android:padding="8dp"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/ShoppingItemListView_Image"
        android:layout_width="82dp"
        android:layout_height="100dp"
        android:paddingTop="3dp"
        android:paddingStart="1dp"
        android:paddingEnd="3dp"
        android:src="@drawable/photo_camera_24px"
        android:layout_marginEnd="8dp"
        android:contentDescription="@string/Picture"
        android:layout_alignParentStart="true" />

    <LinearLayout
        android:id="@+id/ShoppingItemListView_Text"
        android:orientation="vertical"
        android:paddingStart="85dp"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="5dp"
        tools:ignore="RtlSymmetry">
        <TextView
            android:id="@+id/ShoppingItemListView_Heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp" />
        <TextView
            android:id="@+id/ShoppingItemListView_SubHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/ShoppingItemListView_Quantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/Text_Warning"
            android:textSize="20sp"
            android:visibility="visible" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/ShoppingItemListView_Bought"
        android:layout_width="103dp"
        android:layout_height="33dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:buttonTint="@color/Text_Warning"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:paddingEnd="5.0dp"
        android:text="@string/ShoppingList_Bought"
        android:textColor="@color/Text_Warning"
        android:textSize="14sp"
        android:visibility="visible"
        tools:ignore="RtlSymmetry" />

</RelativeLayout>